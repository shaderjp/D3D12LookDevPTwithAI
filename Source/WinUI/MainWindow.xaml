<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="D3D12LookDevPTWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="D3D12LookDevPTWinUI"
    Closed="OnClosed">

    <Grid x:Name="EditorRoot"
          Loaded="OnLoaded"
          PreviewKeyDown="OnPreviewKeyDown"
          PreviewKeyUp="OnPreviewKeyUp"
          GotFocus="OnEditGotFocus"
          LostFocus="OnEditLostFocus"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MenuRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomSplitterRow" Height="6" />
            <RowDefinition x:Name="BottomPaneRow" Height="250" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="330" MinWidth="220" />
            <ColumnDefinition x:Name="LeftSplitterColumn" Width="6" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="380" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <MenuBar x:Name="MainMenu" Grid.Row="0" Grid.ColumnSpan="5">
            <MenuBarItem Title="Project">
                <MenuFlyoutItem Text="Open Scene…" Tag="openScene" Click="OnProjectMenuClick" />
                <MenuFlyoutItem Text="Open Environment…" Tag="openEnvironment" Click="OnProjectMenuClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open Project…" Tag="openProject" Click="OnProjectMenuClick" />
                <MenuFlyoutItem x:Name="SaveProjectMenu" Text="Save Project" Tag="saveProject" Click="OnProjectMenuClick" />
                <MenuFlyoutItem Text="Save Project As…" Tag="saveProjectAs" Click="OnProjectMenuClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SaveStartupMenu" Text="Save Startup Settings" Tag="saveStartup" Click="OnProjectMenuClick" />
                <MenuFlyoutItem Text="Clear Startup Settings" Tag="clearStartup" Click="OnProjectMenuClick" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="ScenePanelMenu" Text="Scene" Tag="SceneTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="MaterialPanelMenu" Text="Material" Tag="MaterialTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="LightingPanelMenu" Text="Lighting" Tag="LightingTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="ViewportPanelMenu" Text="Viewport" Tag="ViewportSettingsTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="PathPanelMenu" Text="Path Tracing" Tag="PathTracingTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="DenoisePanelMenu" Text="Denoise" Tag="DenoiseTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="RestirPanelMenu" Text="ReSTIR" Tag="RestirTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="DiagnosticsPanelMenu" Text="Diagnostics / Stats" Tag="DiagnosticsTab" IsChecked="True" Click="OnPanelToggleClick" />
                <ToggleMenuFlyoutItem x:Name="McpPanelMenu" Text="MCP Server" Tag="McpTab" IsChecked="True" Click="OnPanelToggleClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Show All Panels" Click="OnShowAllPanels" />
                <MenuFlyoutItem Text="Reset Default Layout" Click="OnResetLayout" />
                <ToggleMenuFlyoutItem x:Name="RenderOnlyMenu" Text="Render Only Mode (F10)" Click="OnRenderOnlyClick" />
            </MenuBarItem>
        </MenuBar>

        <Border x:Name="LeftPane"
                Grid.Row="1"
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <TabView x:Name="LeftTabs" IsAddTabButtonVisible="False" CanDragTabs="False">
                <TabViewItem x:Name="SceneTab" Header="Scene" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="5">
                            <TextBlock Text="Scene" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="SceneNameText" Text="Preview cube" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SceneSummaryText" TextWrapping="Wrap" Opacity="0.75" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Open Scene…" Tag="openScene" Click="OnProjectMenuClick" />
                                <Button Content="Open HDRI…" Tag="openEnvironment" Click="OnProjectMenuClick" />
                            </StackPanel>

                            <TextBlock Text="Camera" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Position (X / Y / Z)" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <NumberBox x:Name="CameraXNumber" Tag="camera.position.x" Minimum="-10000" Maximum="10000" SmallChange="0.1"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                           GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                                <NumberBox x:Name="CameraYNumber" Tag="camera.position.y" Minimum="-10000" Maximum="10000" SmallChange="0.1"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                           GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                                <NumberBox x:Name="CameraZNumber" Tag="camera.position.z" Minimum="-10000" Maximum="10000" SmallChange="0.1"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                           GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                            </StackPanel>
                            <TextBlock Text="Yaw / Pitch (degrees)" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <NumberBox x:Name="CameraYawNumber" Tag="camera.yawDegrees" Minimum="-360" Maximum="360" SmallChange="0.25"
                                           Width="140" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                           GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                                <NumberBox x:Name="CameraPitchNumber" Tag="camera.pitchDegrees" Minimum="-83" Maximum="83" SmallChange="0.25"
                                           Width="140" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                           GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                            </StackPanel>
                            <TextBlock Text="Move Speed" />
                            <NumberBox x:Name="MoveSpeedNumber" Tag="camera.moveSpeed" Minimum="0.1" Maximum="50" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                       GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                            <TextBlock Text="Fast Speed" />
                            <NumberBox x:Name="FastSpeedNumber" Tag="camera.fastSpeed" Minimum="0.1" Maximum="100" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                       GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Reset View" Tag="camera.reset" Click="OnActionClick" />
                                <Button Content="Reset Speeds" Tag="camera.speed.reset" Click="OnActionClick" />
                            </StackPanel>

                            <TextBlock Text="XInput Gamepad" Style="{StaticResource SectionHeaderStyle}" />
                            <ToggleSwitch x:Name="GamepadEnabledToggle" Header="Enable navigation" Tag="gamepad.enabled" Toggled="OnToggleChanged" />
                            <TextBlock x:Name="GamepadStatusText" Text="Waiting for controller…" Opacity="0.75" />
                            <TextBlock Text="Look Speed" />
                            <NumberBox x:Name="GamepadLookSpeedNumber" Tag="gamepad.lookSpeed" Minimum="0.25" Maximum="6" SmallChange="0.05"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged"
                                       GotFocus="OnEditGotFocus" LostFocus="OnEditLostFocus" />
                            <CheckBox x:Name="GamepadInvertToggle" Content="Invert look Y" Tag="gamepad.invertY"
                                      Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Recalibrate" Tag="gamepad.recalibrate" Click="OnActionClick" />
                                <Button Content="Standard Center" Tag="gamepad.standardCenter" Click="OnActionClick" />
                            </StackPanel>
                            <TextBlock Text="Right-drag: look · WASD/QE: move · Shift: fast · Space: reset"
                                       TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="MaterialTab" Header="Material" IsClosable="False">
                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MaterialSearchBox" Grid.Row="0" PlaceholderText="Search materials"
                                 TextChanged="OnMaterialSearchChanged" Margin="0,0,0,6" />
                        <ComboBox x:Name="MaterialCombo" Grid.Row="1" PlaceholderText="Select material"
                                  SelectionChanged="OnMaterialSelectionChanged" Margin="0,0,0,8" />
                        <TextBlock x:Name="MaterialDetailsText" Grid.Row="2" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6" />
                        <TabView x:Name="MaterialEditorTabs" Grid.Row="3" IsAddTabButtonVisible="False" CanDragTabs="False">
                            <TabViewItem Header="Properties" IsClosable="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="Base Color" />
                                        <ColorPicker x:Name="BaseColorPicker" Tag="material.baseColor" IsAlphaEnabled="True"
                                                     ColorChanged="OnColorChanged" />
                                        <TextBlock Text="Emissive" />
                                        <ColorPicker x:Name="EmissiveColorPicker" Tag="material.emissive" IsAlphaEnabled="True"
                                                     ColorChanged="OnColorChanged" />
                                        <TextBlock Text="Roughness" />
                                        <Slider x:Name="RoughnessSlider" Tag="material.roughness" Minimum="0.02" Maximum="1"
                                                ValueChanged="OnSliderChanged" />
                                        <NumberBox x:Name="RoughnessNumber" Tag="material.roughness" Minimum="0.02" Maximum="1" SmallChange="0.01"
                                                   Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                        <TextBlock Text="Metallic" />
                                        <Slider x:Name="MetallicSlider" Tag="material.metallic" Minimum="0" Maximum="1"
                                                ValueChanged="OnSliderChanged" />
                                        <NumberBox x:Name="MetallicNumber" Tag="material.metallic" Minimum="0" Maximum="1" SmallChange="0.01"
                                                   Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                        <TextBlock Text="Occlusion Strength" />
                                        <NumberBox x:Name="OcclusionNumber" Tag="material.occlusion" Minimum="0" Maximum="2" SmallChange="0.01"
                                                   Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                        <TextBlock Text="Normal Strength" />
                                        <NumberBox x:Name="NormalStrengthNumber" Tag="material.normalStrength" Minimum="0" Maximum="2" SmallChange="0.01"
                                                   Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                        <CheckBox x:Name="AlphaMaskedToggle" Content="Alpha Mask" Tag="material.alphaMasked"
                                                  Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                        <TextBlock Text="Alpha Cutoff" />
                                        <NumberBox x:Name="AlphaCutoffNumber" Tag="material.alphaCutoff" Minimum="0" Maximum="1" SmallChange="0.01"
                                                   Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                        <CheckBox x:Name="PackedOrmToggle" Content="Packed ORM" Tag="material.packedOrm"
                                                  Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                                        <ComboBox x:Name="MaterialFocusCombo" Header="Material Focus" Tag="material.focus"
                                                  Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                            <ComboBoxItem Content="Normal" />
                                            <ComboBoxItem Content="Isolate" />
                                            <ComboBoxItem Content="Dim Others" />
                                        </ComboBox>
                                        <Button Content="Reset To Source" Tag="material.reset" Click="OnActionClick" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>
                            <TabViewItem Header="Textures" IsClosable="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="8" Spacing="8">
                                        <TextBlock x:Name="Texture0Text" Text="Base Color" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:0" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:0" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:0" Click="OnTextureClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="Texture1Text" Text="Normal" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:1" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:1" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:1" Click="OnTextureClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="Texture2Text" Text="Roughness" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:2" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:2" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:2" Click="OnTextureClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="Texture3Text" Text="Metallic" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:3" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:3" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:3" Click="OnTextureClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="Texture4Text" Text="Occlusion" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:4" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:4" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:4" Click="OnTextureClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="Texture5Text" Text="Emissive" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Load" Tag="load:5" Click="OnTextureClick" />
                                            <Button Content="Clear" Tag="clear:5" Click="OnTextureClick" />
                                            <Button Content="Reset" Tag="reset:5" Click="OnTextureClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabViewItem>
                            <TabViewItem Header="Variants" IsClosable="False">
                                <Grid Padding="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="VariantNameBox" PlaceholderText="Variant name" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,6">
                                        <Button Content="Save Variant" Tag="material.variant.save" Click="OnActionClick" />
                                        <Button Content="Set A" Tag="material.compare.setA" Click="OnActionClick" />
                                        <Button Content="Set B" Tag="material.compare.setB" Click="OnActionClick" />
                                    </StackPanel>
                                    <ListView x:Name="VariantList" Grid.Row="2" SelectionChanged="OnVariantSelectionChanged" />
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5" Margin="0,6,0,0">
                                        <Button x:Name="ApplyVariantButton" Content="Apply" Tag="material.variant.apply" Click="OnActionClick" />
                                        <Button x:Name="DeleteVariantButton" Content="Delete" Tag="material.variant.delete" Click="OnActionClick" />
                                        <Button x:Name="ApplyCompareAButton" Content="Apply A" Tag="material.compare.applyA" Click="OnActionClick" />
                                        <Button x:Name="ApplyCompareBButton" Content="Apply B" Tag="material.compare.applyB" Click="OnActionClick" />
                                    </StackPanel>
                                </Grid>
                            </TabViewItem>
                            <TabViewItem Header="Presets" IsClosable="False">
                                <Grid Padding="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="PresetNameBox" PlaceholderText="User preset name" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,6">
                                        <Button Content="Save User Preset" Tag="material.preset.save" Click="OnActionClick" />
                                        <Button Content="Reload" Tag="material.preset.reload" Click="OnActionClick" />
                                    </StackPanel>
                                    <ListView x:Name="PresetList" Grid.Row="2" SelectionChanged="OnPresetSelectionChanged" />
                                    <Button x:Name="ApplyPresetButton" Grid.Row="3" Content="Apply Preset" Tag="material.preset.apply"
                                            Click="OnActionClick" Margin="0,6,0,0" />
                                </Grid>
                            </TabViewItem>
                        </TabView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Name="LightingTab" Header="Lighting" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock Text="Sun and Sky" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Key Light Direction (X / Y / Z)" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <NumberBox x:Name="LightDirectionXNumber" Tag="lighting.direction.x" Minimum="-1" Maximum="1" SmallChange="0.01"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="LightDirectionYNumber" Tag="lighting.direction.y" Minimum="-1" Maximum="1" SmallChange="0.01"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="LightDirectionZNumber" Tag="lighting.direction.z" Minimum="-1" Maximum="1" SmallChange="0.01"
                                           Width="92" Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            </StackPanel>
                            <TextBlock Text="Key Light Color" />
                            <ColorPicker x:Name="LightColorPicker" Tag="lighting.lightColor" IsAlphaEnabled="False"
                                         ColorChanged="OnColorChanged" />
                            <TextBlock Text="Key Light Intensity" />
                            <Slider x:Name="LightIntensitySlider" Tag="lighting.intensity" Minimum="0" Maximum="20" ValueChanged="OnSliderChanged" />
                            <NumberBox x:Name="LightIntensityNumber" Tag="lighting.intensity" Minimum="0" Maximum="20" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <Button Content="Reset Light" Tag="light.reset" Click="OnActionClick" HorizontalAlignment="Left" />
                            <TextBlock Text="Ray Bias / TMin" />
                            <NumberBox x:Name="RayTMinNumber" Tag="lighting.rayTMin" Minimum="0.001" Maximum="0.25" SmallChange="0.001"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="SkyEnabledToggle" Header="Sky Enabled" Tag="lighting.skyEnabled" Toggled="OnToggleChanged" />
                            <TextBlock Text="Sky Color" />
                            <ColorPicker x:Name="SkyColorPicker" Tag="lighting.skyColor" IsAlphaEnabled="False"
                                         ColorChanged="OnColorChanged" />
                            <TextBlock Text="Sky Horizon Color" />
                            <ColorPicker x:Name="SkyHorizonColorPicker" Tag="lighting.skyHorizonColor" IsAlphaEnabled="False"
                                         ColorChanged="OnColorChanged" />
                            <TextBlock Text="Sky Zenith Color" />
                            <ColorPicker x:Name="SkyZenithColorPicker" Tag="lighting.skyZenithColor" IsAlphaEnabled="False"
                                         ColorChanged="OnColorChanged" />
                            <TextBlock Text="Sky Ground Color" />
                            <ColorPicker x:Name="SkyGroundColorPicker" Tag="lighting.skyGroundColor" IsAlphaEnabled="False"
                                         ColorChanged="OnColorChanged" />
                            <TextBlock Text="Sky Intensity" />
                            <NumberBox x:Name="SkyIntensityNumber" Tag="lighting.skyIntensity" Minimum="0" Maximum="10" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Sun Intensity" />
                            <NumberBox x:Name="SunIntensityNumber" Tag="lighting.sunIntensity" Minimum="0" Maximum="50" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Sun Size" />
                            <NumberBox x:Name="SunSizeNumber" Tag="lighting.sunSize" Minimum="0.001" Maximum="0.08" SmallChange="0.001"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Environment" Style="{StaticResource SectionHeaderStyle}" />
                            <ToggleSwitch x:Name="EnvironmentEnabledToggle" Header="Environment Map" Tag="lighting.environmentEnabled" Toggled="OnToggleChanged" />
                            <TextBlock Text="Environment Intensity" />
                            <NumberBox x:Name="EnvironmentIntensityNumber" Tag="lighting.environmentIntensity" Minimum="0" Maximum="10" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Environment Rotation" />
                            <NumberBox x:Name="EnvironmentRotationNumber" Tag="lighting.environmentRotation" Minimum="-3.14159" Maximum="3.14159" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="SunNeeToggle" Header="Sun NEE" Tag="lighting.sunNee" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="SkyNeeToggle" Header="Sky NEE" Tag="lighting.skyNee" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="EmissiveEnabledToggle" Header="Emissive Triangle Lights" Tag="lighting.emissiveEnabled" Toggled="OnToggleChanged" />
                            <TextBlock Text="Emissive Intensity" />
                            <NumberBox x:Name="EmissiveIntensityNumber" Tag="lighting.emissiveIntensity" Minimum="0" Maximum="30" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="AreaEnabledToggle" Header="Procedural Area Lights" Tag="lighting.areaEnabled" Toggled="OnToggleChanged" />
                            <TextBlock Text="Area Light Intensity" />
                            <NumberBox x:Name="AreaIntensityNumber" Tag="lighting.areaIntensity" Minimum="0" Maximum="50" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Border>

        <Thumb x:Name="LeftSplitter" Grid.Row="1" Grid.Column="1"
               Background="Transparent" DragDelta="OnLeftSplitterDrag" />

        <Grid x:Name="ViewportHost"
              Grid.Row="1"
              Grid.Column="2"
              Background="Black"
              SizeChanged="OnViewportHostSizeChanged">
            <SwapChainPanel x:Name="ViewportPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Loaded="OnViewportLoaded">
                <Grid x:Name="LoadingOverlay" IsHitTestVisible="False" Background="Black">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="36" Height="36" />
                        <TextBlock x:Name="LoadingText" Text="Initializing Direct3D 12 renderer…" Foreground="White" />
                    </StackPanel>
                </Grid>
                <Button x:Name="ViewportInputSurface"
                        AutomationProperties.Name="Viewport input surface"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsTabStop="True"
                        UseSystemFocusVisuals="False"
                        ClickMode="Press"
                        GotFocus="OnViewportGotFocus"
                        LostFocus="OnViewportLostFocus"
                        PointerPressed="OnViewportPointerPressed"
                        PointerMoved="OnViewportPointerMoved"
                        PointerReleased="OnViewportPointerReleased"
                        PointerExited="OnViewportPointerExited"
                        PointerWheelChanged="OnViewportPointerWheelChanged" />
            </SwapChainPanel>
        </Grid>

        <Thumb x:Name="RightSplitter" Grid.Row="1" Grid.Column="3"
               Background="Transparent" DragDelta="OnRightSplitterDrag" />

        <Border x:Name="RightPane"
                Grid.Row="1"
                Grid.Column="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <TabView x:Name="RightTabs" IsAddTabButtonVisible="False" CanDragTabs="False">
                <TabViewItem x:Name="ViewportSettingsTab" Header="Viewport" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="4">
                            <ComboBox x:Name="RenderModeCombo" Header="Render Mode" Tag="renderer.mode"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Baseline PT" />
                                <ComboBoxItem Content="ReSTIR GI" />
                                <ComboBoxItem Content="ReSTIR DI" />
                                <ComboBoxItem Content="ReSTIR Combined" />
                            </ComboBox>
                            <ComboBox x:Name="ResolutionCombo" Header="Internal Resolution" Tag="viewport.resolution"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="1280 × 720" />
                                <ComboBoxItem Content="1920 × 1080" />
                                <ComboBoxItem Content="3840 × 2160" />
                            </ComboBox>
                            <ComboBox x:Name="DebugViewCombo" Header="Debug View" Tag="viewport.debugView"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Final" />
                                <ComboBoxItem Content="Base Color" />
                                <ComboBoxItem Content="World Normal" />
                                <ComboBoxItem Content="Normal Texture" />
                                <ComboBoxItem Content="Roughness" />
                                <ComboBoxItem Content="Metallic" />
                                <ComboBoxItem Content="Emissive" />
                                <ComboBoxItem Content="Hit Distance" />
                                <ComboBoxItem Content="Direct NEE" />
                                <ComboBoxItem Content="Indirect" />
                                <ComboBoxItem Content="Bounce Count" />
                                <ComboBoxItem Content="Accumulation Samples" />
                                <ComboBoxItem Content="Sky" />
                                <ComboBoxItem Content="Reservoir Weight" />
                                <ComboBoxItem Content="Temporal Reuse" />
                                <ComboBoxItem Content="Spatial Reuse" />
                                <ComboBoxItem Content="Current Radiance" />
                                <ComboBoxItem Content="Temporal Output" />
                                <ComboBoxItem Content="History Length" />
                                <ComboBoxItem Content="Variance" />
                                <ComboBoxItem Content="Motion Vector" />
                                <ComboBoxItem Content="Disocclusion Mask" />
                                <ComboBoxItem Content="Denoised Indirect" />
                                <ComboBoxItem Content="Denoise Delta" />
                                <ComboBoxItem Content="Reservoir Age" />
                                <ComboBoxItem Content="Reservoir Validity" />
                                <ComboBoxItem Content="GI Reservoir Weight" />
                                <ComboBoxItem Content="DI Reservoir Weight" />
                                <ComboBoxItem Content="GI Temporal Reuse" />
                                <ComboBoxItem Content="DI Temporal Reuse" />
                                <ComboBoxItem Content="GI Spatial Reuse" />
                                <ComboBoxItem Content="DI Spatial Reuse" />
                                <ComboBoxItem Content="Diffuse Signal" />
                                <ComboBoxItem Content="Specular Signal" />
                                <ComboBoxItem Content="Emission / Sky" />
                                <ComboBoxItem Content="Temporal Input" />
                                <ComboBoxItem Content="Temporal Output Detail" />
                                <ComboBoxItem Content="A-Trous Output" />
                                <ComboBoxItem Content="Reactive Mask" />
                                <ComboBoxItem Content="History Match" />
                                <ComboBoxItem Content="History Confidence" />
                                <ComboBoxItem Content="NRD World Normal" />
                                <ComboBoxItem Content="NRD Roughness" />
                                <ComboBoxItem Content="NRD Linear View-Z" />
                                <ComboBoxItem Content="NRD 2.5D Motion" />
                                <ComboBoxItem Content="NRD Disocclusion / History" />
                                <ComboBoxItem Content="NRD Input Validation" />
                                <ComboBoxItem Content="TAA History Length" />
                                <ComboBoxItem Content="TAA History Acceptance" />
                            </ComboBox>
                            <CheckBox x:Name="NormalYFlipToggle" Content="Normal Map Y Flip" Tag="viewport.normalYFlip"
                                      Checked="OnToggleChanged" Unchecked="OnToggleChanged" />
                            <ComboBox x:Name="ToneMapperCombo" Header="Tone Mapper" Tag="viewport.toneMapper"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Reinhard" />
                                <ComboBoxItem Content="ACES" />
                            </ComboBox>
                            <TextBlock Text="Exposure (EV)" />
                            <Slider x:Name="ExposureSlider" Tag="viewport.exposure" Minimum="-6" Maximum="6" ValueChanged="OnSliderChanged" />
                            <NumberBox x:Name="ExposureNumber" Tag="viewport.exposure" Minimum="-6" Maximum="6" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Gamma" />
                            <NumberBox x:Name="GammaNumber" Tag="viewport.gamma" Minimum="1" Maximum="3" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="VsyncToggle" Header="VSync" Tag="viewport.vsync" Toggled="OnToggleChanged" />
                            <Button Content="Reset Accumulation" Tag="history.reset" Click="OnActionClick" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="PathTracingTab" Header="Path Tracing" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock Text="Samples / Frame" />
                            <NumberBox x:Name="SamplesNumber" Tag="path.samples" Minimum="1" Maximum="8"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Max Bounces" />
                            <NumberBox x:Name="MaxBouncesNumber" Tag="path.maxBounces" Minimum="1" Maximum="8"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Min Bounces" />
                            <NumberBox x:Name="MinBouncesNumber" Tag="path.minBounces" Minimum="0" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Radiance Clamp" />
                            <NumberBox x:Name="RadianceClampNumber" Tag="path.radianceClamp" Minimum="0" Maximum="100" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Temporal Clamp" />
                            <NumberBox x:Name="TemporalClampNumber" Tag="path.temporalClamp" Minimum="0.25" Maximum="4" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Max Accumulation Samples" />
                            <NumberBox x:Name="MaxAccumulationNumber" Tag="path.maxAccumulation" Minimum="1" Maximum="4096"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="FreezeToggle" Header="Freeze Accumulation" Tag="path.freeze" Toggled="OnToggleChanged" />
                            <TextBlock Text="Adaptive Sampling" Style="{StaticResource SectionHeaderStyle}" />
                            <ToggleSwitch x:Name="AdaptiveToggle" Header="Adaptive Samples" Tag="path.adaptive" Toggled="OnToggleChanged" />
                            <TextBlock Text="Max Adaptive SPP" />
                            <NumberBox x:Name="MaxAdaptiveNumber" Tag="path.maxAdaptive" Minimum="1" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Variance Threshold" />
                            <NumberBox x:Name="VarianceThresholdNumber" Tag="path.varianceThreshold" Minimum="0.02" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Disocclusion Boost" />
                            <NumberBox x:Name="DisocclusionBoostNumber" Tag="path.disocclusionBoost" Minimum="0" Maximum="4" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="DenoiseTab" Header="Denoise" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock x:Name="DenoiseStatusText" TextWrapping="Wrap" Opacity="0.75" />
                            <ToggleSwitch x:Name="DenoiseEnabledToggle" Header="Denoiser Enabled" Tag="denoise.enabled" Toggled="OnToggleChanged" />
                            <ComboBox x:Name="DenoiseBackendCombo" Header="Denoise Backend" Tag="denoise.backend"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Internal" />
                                <ComboBoxItem Content="NRD REBLUR" />
                                <ComboBoxItem Content="NRD RELAX" />
                                <ComboBoxItem Content="DLSS Ray Reconstruction" />
                                <ComboBoxItem Content="Off" />
                            </ComboBox>
                            <ComboBox x:Name="DlssModeCombo" Header="DLSS Mode" Tag="denoise.dlssMode"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Quality" />
                                <ComboBoxItem Content="Balanced" />
                                <ComboBoxItem Content="Performance" />
                                <ComboBoxItem Content="Ultra Performance" />
                            </ComboBox>
                            <ToggleSwitch x:Name="DlssAvailableToggle" Header="DLSS Enabled When Available" Tag="denoise.dlssAvailable" Toggled="OnToggleChanged" />
                            <ComboBox x:Name="NoisePresetCombo" Header="Noise Preset" Tag="denoise.preset"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Interactive Stable" />
                                <ComboBoxItem Content="Sharp Preview" />
                                <ComboBoxItem Content="Still Capture" />
                            </ComboBox>
                            <ComboBox x:Name="JitterModeCombo" Header="Jitter Mode" Tag="denoise.jitterMode"
                                      Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                <ComboBoxItem Content="Stable 32" />
                                <ComboBoxItem Content="Halton" />
                                <ComboBoxItem Content="Off" />
                            </ComboBox>
                            <ToggleSwitch x:Name="SplitSignalToggle" Header="Split Signal Denoise" Tag="denoise.splitSignal" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="RealtimeToggle" Header="Realtime Reconstruction" Tag="denoise.realtime" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="TemporalStabilityToggle" Header="Temporal Stability" Tag="denoise.temporalStability" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="CameraJitterToggle" Header="Camera Jitter" Tag="denoise.cameraJitter" Toggled="OnToggleChanged" />
                            <TextBlock Text="Moving Jitter Scale" />
                            <NumberBox x:Name="MovingJitterScaleNumber" Tag="denoise.movingJitterScale" Minimum="0" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Max History Frames" />
                            <NumberBox x:Name="HistoryFramesNumber" Tag="denoise.historyFrames" Minimum="1" Maximum="128"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Temporal Alpha Min" />
                            <NumberBox x:Name="TemporalAlphaMinNumber" Tag="denoise.temporalAlphaMin" Minimum="0.01" Maximum="0.5" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Temporal Alpha Max" />
                            <NumberBox x:Name="TemporalAlphaMaxNumber" Tag="denoise.temporalAlphaMax" Minimum="0.02" Maximum="0.8" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="History Clamp Sigma" />
                            <NumberBox x:Name="HistoryClampNumber" Tag="denoise.historyClamp" Minimum="0.5" Maximum="4" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Reactive Threshold" />
                            <NumberBox x:Name="ReactiveNumber" Tag="denoise.reactive" Minimum="0.05" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Specular History Scale" />
                            <NumberBox x:Name="SpecularHistoryScaleNumber" Tag="denoise.specularHistoryScale" Minimum="0" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Spatial Iterations" />
                            <NumberBox x:Name="SpatialIterationsNumber" Tag="denoise.spatialIterations" Minimum="0" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="A-Trous Passes" />
                            <NumberBox x:Name="AtrousPassesNumber" Tag="denoise.atrousPasses" Minimum="0" Maximum="5"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Diffuse Filter Strength" />
                            <NumberBox x:Name="DiffuseStrengthNumber" Tag="denoise.diffuseStrength" Minimum="0" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Specular Filter Strength" />
                            <NumberBox x:Name="SpecularStrengthNumber" Tag="denoise.specularStrength" Minimum="0" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Variance Scale" />
                            <NumberBox x:Name="DenoiseVarianceScaleNumber" Tag="denoise.varianceScale" Minimum="0.25" Maximum="4" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Normal Sigma" />
                            <NumberBox x:Name="NormalSigmaNumber" Tag="denoise.normalSigma" Minimum="0.05" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Depth Sigma" />
                            <NumberBox x:Name="DepthSigmaNumber" Tag="denoise.depthSigma" Minimum="0.002" Maximum="0.1" SmallChange="0.001"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Luminance Sigma" />
                            <NumberBox x:Name="LuminanceSigmaNumber" Tag="denoise.luminanceSigma" Minimum="0.1" Maximum="8" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Albedo Sigma" />
                            <NumberBox x:Name="AlbedoSigmaNumber" Tag="denoise.albedoSigma" Minimum="0.05" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Denoiser Strength" />
                            <NumberBox x:Name="DenoiseStrengthNumber" Tag="denoise.strength" Minimum="0" Maximum="1" SmallChange="0.01"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button Content="Reset History" Tag="denoise.reset" Click="OnActionClick" />
                                <Button Content="Reset DLSS" Tag="dlss.reset" Click="OnActionClick" />
                                <Button Content="Reset NRD" Tag="nrd.reset" Click="OnActionClick" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Name="RestirTab" Header="ReSTIR" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock x:Name="RestirStatusText" Text="Controls are active for ReSTIR rendering modes." TextWrapping="Wrap" Opacity="0.7" />
                            <ToggleSwitch x:Name="RestirTemporalToggle" Header="Temporal Reuse" Tag="restir.temporal" Toggled="OnToggleChanged" />
                            <TextBlock Text="Spatial Reuse Passes" />
                            <NumberBox x:Name="RestirSpatialPassesNumber" Tag="restir.spatialPasses" Minimum="0" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Spatial Radius" />
                            <NumberBox x:Name="RestirRadiusNumber" Tag="restir.radius" Minimum="1" Maximum="64"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Candidate Samples / Pixel" />
                            <NumberBox x:Name="RestirCandidatesNumber" Tag="restir.candidates" Minimum="1" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="Reservoir M Clamp" />
                            <NumberBox x:Name="RestirClampNumber" Tag="restir.mClamp" Minimum="1" Maximum="64" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="ReSTIR DI" Style="{StaticResource SectionHeaderStyle}" />
                            <ToggleSwitch x:Name="RestirDiTemporalToggle" Header="DI Temporal Reuse" Tag="restir.diTemporal" Toggled="OnToggleChanged" />
                            <TextBlock Text="DI Spatial Reuse Passes" />
                            <NumberBox x:Name="RestirDiSpatialPassesNumber" Tag="restir.diSpatialPasses" Minimum="0" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="DI Candidate Samples / Pixel" />
                            <NumberBox x:Name="RestirDiCandidatesNumber" Tag="restir.diCandidates" Minimum="1" Maximum="4"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <TextBlock Text="DI Reservoir M Clamp" />
                            <NumberBox x:Name="RestirDiClampNumber" Tag="restir.diMClamp" Minimum="1" Maximum="64" SmallChange="0.1"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <ToggleSwitch x:Name="RestirReprojectionToggle" Header="Reservoir Reprojection" Tag="restir.reprojection" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="RestirValidationToggle" Header="Reservoir Validation" Tag="restir.validation" Toggled="OnToggleChanged" />
                            <ToggleSwitch x:Name="RestirGiValidationToggle" Header="GI Validation Ray" Tag="restir.giValidationRay" Toggled="OnToggleChanged" />
                            <TextBlock Text="Reservoir Max Age" />
                            <NumberBox x:Name="RestirMaxAgeNumber" Tag="restir.maxAge" Minimum="1" Maximum="32"
                                       Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                            <Button Content="Reset Reservoirs" Tag="restir.reset" Click="OnActionClick" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Border>

        <Thumb x:Name="BottomSplitter"
               Grid.Row="2"
               Grid.ColumnSpan="5"
               Background="Transparent"
               DragDelta="OnBottomSplitterDrag" />

        <Border x:Name="BottomPane"
                Grid.Row="3"
                Grid.ColumnSpan="5"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TabView x:Name="BottomTabs" IsAddTabButtonVisible="False" CanDragTabs="False">
                <TabViewItem x:Name="DiagnosticsTab" Header="Diagnostics / Stats" IsClosable="False">
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0">
                            <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" FontFamily="Consolas" />
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="1">
                            <TextBlock x:Name="StatsText" TextWrapping="Wrap" FontFamily="Consolas" />
                        </ScrollViewer>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Name="McpTab" Header="MCP Server" IsClosable="False">
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="McpStatusText" Text="Stopped" FontWeight="SemiBold" />
                                <TextBlock x:Name="McpCountsText" TextWrapping="Wrap" Opacity="0.75" />
                                <TextBlock x:Name="McpEndpointText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Start" Tag="mcp.start" Click="OnActionClick" />
                                    <Button Content="Stop" Tag="mcp.stop" Click="OnActionClick" />
                                </StackPanel>
                                <TextBlock Text="Port" />
                                <NumberBox x:Name="McpPortNumber" Tag="mcp.port" Minimum="1" Maximum="65535"
                                           Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                <TextBlock Text="Request Timeout (seconds)" />
                                <NumberBox x:Name="McpTimeoutNumber" Tag="mcp.timeout" Minimum="5" Maximum="300"
                                           Style="{StaticResource EditorNumberStyle}" ValueChanged="OnNumberChanged" />
                                <ComboBox x:Name="McpAccessCombo" Header="Access Mode" Tag="mcp.access"
                                          Style="{StaticResource EditorComboStyle}" SelectionChanged="OnComboChanged">
                                    <ComboBoxItem Content="Read Only" />
                                    <ComboBoxItem Content="Confirm Mutations" />
                                    <ComboBoxItem Content="Allow Mutations" />
                                </ComboBox>
                                <TextBox x:Name="McpTokenBox" Header="Bearer Token" IsReadOnly="True" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Copy Token" Click="OnCopyToken" />
                                    <Button Content="Regenerate" Tag="mcp.token.regenerate" Click="OnActionClick" />
                                </StackPanel>
                                <TextBlock x:Name="McpErrorText" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Column="1" Margin="12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pending Approvals" FontWeight="SemiBold" />
                            <ListView x:Name="ApprovalList" Grid.Row="1" SelectionChanged="OnApprovalSelectionChanged" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ApproveButton" Content="Approve" Tag="mcp.approve" Click="OnActionClick" />
                                <Button x:Name="RejectButton" Content="Reject" Tag="mcp.reject" Click="OnActionClick" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recent Requests" FontWeight="SemiBold" />
                            <ListView x:Name="RecentRequestsList" Grid.Row="1" />
                        </Grid>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Border>

        <InfoBar x:Name="RendererInfoBar"
                 Grid.Row="4"
                 Grid.ColumnSpan="5"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Renderer"
                 Message="Starting…" />
    </Grid>
</Window>
